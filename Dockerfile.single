# Single-stage build, kept only as a point of comparison against the real
# Dockerfile. It is NOT what ships.
#
# Everything happens in one image: the build tooling used to compile and
# install dependencies stays in the final result alongside the application,
# because there is no second stage to leave it behind.
#
# Build both and compare:
#   docker build -t fleet-monitor:multistage .
#   docker build -t fleet-monitor:single -f Dockerfile.single .
#   docker images fleet-monitor
#
# Measured on this project:
#
#            transferred   on disk
#   single       203 MB     785 MB
#   multistage    71 MB     301 MB
#                 -65%      -62%
#
# The 132 MB saved per transfer is what a compiler and pip's caches cost when
# they are allowed to reach production. Across a 200-vessel fleet on metered
# satellite links, that is roughly 26 GB per rollout.

FROM python:3.12-slim

# Build tooling a naive image ends up carrying. Needed to compile packages
# that ship no prebuilt wheel; useless once the install has finished, and in
# a single-stage build there is no way to drop it afterwards.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY app/ ./app/

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
