# Configuration template for fleet-monitor.
#
# This file is COMMITTED and must never contain real credentials.
# To get started:  cp .env.example .env   and edit the copy.
# The resulting .env is git-ignored.

# ── Application ─────────────────────────────────────
APP_NAME=fleet-monitor
APP_VERSION=0.1.0
ENVIRONMENT=development

# ── Database ────────────────────────────────────────
# Compose builds DATABASE_URL from these three values and passes it to the API.
# Running the API outside Compose? Set DATABASE_URL directly instead.
POSTGRES_USER=fleet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fleet

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# The host is the Compose service name, not localhost, because the API reaches
# the database over the Compose network.
DATABASE_URL=postgresql+psycopg://fleet:changeme@db:5432/fleet

# Host port the API is published on. Change it if 8000 is already taken.
API_PORT=8000

# ── Node status thresholds (seconds) ────────────────
# A node is ONLINE below STALE_AFTER_SECONDS, STALE up to OFFLINE_AFTER_SECONDS,
# and OFFLINE beyond that.
#
# Keep STALE_AFTER_SECONDS at several times HEARTBEAT_INTERVAL_SECONDS. At the
# defaults below a node must miss four consecutive beats before it is flagged,
# which absorbs a dropped packet without turning the dashboard amber — an
# operator who sees false alarms daily stops reading the dashboard at all.
STALE_AFTER_SECONDS=120
OFFLINE_AFTER_SECONDS=600

# ── Vessel agents ───────────────────────────────────
# Shared by every replica started with `--scale agent=N`. NODE_NAME is
# deliberately absent: each agent generates its own, so replicas register as
# distinct vessels instead of colliding on one name.
AGENT_SW_VERSION=1.4.2
AGENT_VESSEL_NAME=MV Simulated
AGENT_LOCATION=North Atlantic
HEARTBEAT_INTERVAL_SECONDS=30
